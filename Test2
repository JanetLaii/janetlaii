terraform {
  required_version = ">= 1.6.0"
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.30"
    }
  }
}

provider "aws" {
  region = "us-east-1"
}

resource "aws_s3_bucket" "onboarding_bucket" {
  bucket = "my-company-onboarding-bucket-xyz"

  tags = {
    Environment = "Sandbox"
    ManagedBy   = "Terraform"
  }
}
